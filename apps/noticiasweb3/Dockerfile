FROM node:20-slim AS build

WORKDIR /app

COPY apps/noticiasweb3/package*.json ./
RUN npm install

COPY apps/noticiasweb3 .

ARG VITE_ADSENSE_ID
ENV VITE_ADSENSE_ID=$VITE_ADSENSE_ID

ARG VITE_ADSENSE_SLOT_TOP
ENV VITE_ADSENSE_SLOT_TOP=$VITE_ADSENSE_SLOT_TOP

ARG VITE_ADSENSE_SLOT_RIGHT
ENV VITE_ADSENSE_SLOT_RIGHT=$VITE_ADSENSE_SLOT_RIGHT

ARG VITE_ADSENSE_SLOT_INLINE
ENV VITE_ADSENSE_SLOT_INLINE=$VITE_ADSENSE_SLOT_INLINE

ARG VITE_GOOGLE_ANALYTICS_ID
ENV VITE_GOOGLE_ANALYTICS_ID=$VITE_GOOGLE_ANALYTICS_ID

ARG VITE_POCKETBASE_URL
ENV VITE_POCKETBASE_URL=$VITE_POCKETBASE_URL

RUN npm run build

FROM nginx:1.27-alpine

COPY apps/noticiasweb3/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

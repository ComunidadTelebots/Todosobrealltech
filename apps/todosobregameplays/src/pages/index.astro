---
import App from '../main.jsx';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      if (new URLSearchParams(location.search).get('miniapp') === '1' || window.self !== window.top) {
        document.documentElement.classList.add('miniapp');
      }
    </script>
    <meta name="description" content="Visor web del canal de Telegram TodoSobreGameplays." />
    <link rel="canonical" href="https://todosobregameplays.todosobreall.tech/" />
    <title>TodoSobreGameplays</title>
    <script src="https://assets.todosobreall.tech/netbar.js" defer is:inline></script>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Todo Sobre Gameplays" />
    <meta property="og:title" content="Todo Sobre Gameplays — Análisis y vídeos de juegos" />
    <meta property="og:description" content="Gameplays comentados, análisis de juegos retro y modernos, y guías sin spoilers." />
    <meta property="og:url" content="https://todosobregameplays.todosobreall.tech/" />
    <meta property="og:image" content="https://todosobregameplays.todosobreall.tech/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Todo Sobre Gameplays — Análisis y vídeos de juegos" />
    <meta name="twitter:description" content="Gameplays comentados, análisis de juegos retro y modernos, y guías sin spoilers." />
    <meta name="twitter:image" content="https://todosobregameplays.todosobreall.tech/og-image.png" />
  </head>
  <body>
    <tsa-netbar current="gameplays"></tsa-netbar>
    <App client:load />
  </body>
</html>

    "i18next-localstorage-backend": "^2.1.2",
    "idb-keyval": "^3.2.0",
    "iframe-resizer": "^4.2.1",
    "libphonenumber-js": "^1.7.13",
    "localforage": "1.10.0",
    "lottie-web": "^5.5.10",
    "notistack": "^0.5.1",

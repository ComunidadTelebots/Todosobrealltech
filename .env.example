# Public web
WEB_HOST=todosobreall.tech
VITE_GOOGLE_ANALYTICS_ID=G-F5P08EW3SV
VITE_ADSENSE_ID=
VITE_ADSENSE_SLOT_TOP=
VITE_ADSENSE_SLOT_RIGHT=
VITE_ADSENSE_SLOT_INLINE=
WEB_STABLE_VERSION=local
# Versiones/hosts opt-in usados por docker-compose.release.yml.
WEB_RC_VERSION=rc-local
WEB_BETA_VERSION=beta-local
WEB_ALPHA_VERSION=alpha-local
WEB_RC_HOST=rc.todosobreall.tech
WEB_BETA_HOST=beta.todosobreall.tech
WEB_ALPHA_HOST=alpha.todosobreall.tech
# Debe permanecer false hasta desplegar el gateway autenticado de releases.
RELEASE_CHANNELS_PUBLIC=false
RELEASE_FORWARD_AUTH_SECRET=
RELEASE_COOKIE_DOMAIN=.todosobreall.tech

# Traefik
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# API
PORT=3001
CORS_ORIGIN=https://todosobreall.tech
POCKETBASE_HOST=http://todosobrealltech-pocketbase:8090
MOONBOT_PUBLIC_URL=http://moonbot:5000
MOONBOT_INTERNAL_URL=http://moonbot:5000
TRAEFIK_API_URL=http://traefik:8080/api/http/routers
# Debe coincidir con MOON_ADMIN_API_KEY en /root/moonbot/.env
MOON_ADMIN_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_CLIENT_ID=209219812
# Token del bot de NoticiasWeb3, usado por rssAutoPublisher para editar los posts del canal.
# Bot creado con @BotFather; debe ser administrador del canal con permiso de editar mensajes.
BOT_TOKEN_NW3=
# URL base pública de NoticiasWeb3 (usada en el enlace "Leer en NW3" y en el feed RSS).
SITE_URL=https://noticiasweb3.todosobreall.tech
# Una sola frase breve en los posts nuevos de @TodoSobreAllTech.
RSS_TELEGRAM_SUMMARY_CHARS=180
# Espera antes de editar posts externos para que @InsideAds_bot inserte su campaña.
RSS_CHANNEL_EDIT_MIN_AGE_MS=300000
CAS_API_URL=https://cas.chat/api/blocked-users
# API token encryption key. Use 64 hex chars, for example: openssl rand -hex 32
ENCRYPTION_KEY=

# PocketBase superuser used by the API service
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=
# PocketBase encryption key. Use 32 chars/bytes and never change it after data exists.
PB_ENCRYPTION_KEY=

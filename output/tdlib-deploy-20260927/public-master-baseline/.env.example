# ====================================
# Moon Multibot - Configuracion
# ====================================

# --- Flask & Web ---
WEB_PASSWORD=tu_contrasena_segura
JWT_SECRET=tu_jwt_secret_muy_seguro
MOON_ENV=prod
MOON_ROLE=master
MASTER_ID=123456789

# --- Flask server ---
# Puerto del dashboard (default: 5000 en prod, 5001 en dev)
FLASK_PORT=5000
# Hilos del servidor Waitress en produccion
FLASK_THREADS=6

# --- Analytics & cookies (opcional) ---
# Measurement ID de Google Analytics 4. Ejemplo: G-XXXXXXXXXX
GOOGLE_ANALYTICS_ID=

# --- Cifrado de tokens ---
# Generado automaticamente en primera ejecucion si se deja vacio.
# Copia aqui el valor impreso en consola para conservar acceso a bots cifrados.
CIPHER_KEY=

# --- IA & LLM ---
GEMINI_API_KEY=
OPENAI_API_KEY=
USE_EXTERNAL_LLM=false
HYBRID_PERCENTAGE=50
LLM_PROVIDER=gemini
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2:0.5b

# --- Deep Dream Mode ---
DEEP_DREAM_MODE=false

# --- Moderacion ---
# TTL en segundos del cache CAS (Combot Anti-Spam)
CAS_CACHE_TTL=1800

# --- VirusTotal (opcional) ---
VT_API_KEY=

# --- TDLib - MTProto user client (opcional) ---
# Obtener en https://my.telegram.org con tu cuenta de usuario
# Si no se configuran, TDLib queda deshabilitado sin afectar el bot
TDLIB_API_ID=
TDLIB_API_HASH=
# Ruta al binario libtdjson.so compilado (default: /usr/local/lib/libtdjson.so en Docker)
TDLIB_PATH=/usr/local/lib/libtdjson.so

# --- Proxies locales MTProto (opcional) ---
# PROXY_LOCAL_PORTS=8443,8444,8445
# PROXY_LOCAL_SECRETS=secret_hex_1,secret_hex_2,secret_hex_3

# --- VPS remoto para proxies (opcional) ---
# PROXY_VPS_HOST=203.0.113.10
# PROXY_VPS_USER=root
# PROXY_VPS_PORT=22
# PROXY_VPS_PASSWORD=
# PROXY_VPS_KEY_PATH=
# PROXY_VPS_KEY_PASSPHRASE=
# PROXY_VPS_PORTS=8443,8444,8445,8446

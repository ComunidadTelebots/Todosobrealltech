# Config de los scripts de mantenimiento de proxies MTProto (host, vía cron).
# Copia a scripts/.env con tus valores reales (scripts/.env está gitignored).
BW_MASTER_ID=123456789
BW_BUDGET_TB=8
BW_BASELINE_MONTH=
BW_BASELINE_GB=0
BOTS_JSON=/ruta/a/moonbot/data/bots.json
MTPROTO_RATE_AGG=1gbit
MTPROTO_RATE_CONN=10mbit
MTPROTO_CONTAINERS={"contenedor-mtproxy":["nombre-proxy",443]}
MTPROTO_CONTAINER_NAMES=contenedor-1 contenedor-2 contenedor-3
CONN_DATA_DIR=/var/lib/docker/volumes/PROYECTO_proxy_history/_data
